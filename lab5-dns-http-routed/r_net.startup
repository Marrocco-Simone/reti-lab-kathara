# Router NET
# eth0: NET network (192.168.2.0/24)
# eth1: LINK_IN to R_IT (192.168.20.0/24)
# eth2: LINK_RN to R_ROOT (192.168.30.0/24)

ip addr add 192.168.2.100/24 dev eth0
ip addr add 192.168.20.2/24 dev eth1
ip addr add 192.168.30.2/24 dev eth2

ip link set eth0 up
ip link set eth1 up
ip link set eth2 up

# Routes to other networks
ip route add 192.168.0.0/24 via 192.168.30.1   # ROOT network via R_ROOT
ip route add 192.168.1.0/24 via 192.168.20.1   # IT network via R_IT
ip route add 192.168.10.0/24 via 192.168.20.1  # LINK_RI via R_IT
