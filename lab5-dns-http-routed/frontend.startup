#!/bin/bash
# Frontend Server - NET network (192.168.2.0/24)
ip address add 192.168.2.113/24 dev eth0
ip link set eth0 up
route add default gw 192.168.2.100 dev eth0

# Start the frontend service (dependencies already installed in Docker image)
cd /opt/frontend
python3 -m uvicorn app.main:app --host 0.0.0.0 --port 80 &
