ip address add 10.0.1.2/24 dev eth0   # A: R1 lato PC1
ip link set eth0 up
ip address add 10.0.5.2/24 dev eth1   # E: R1-R2, R1 usa .2 (ID basso)
ip link set eth1 up
ip address add 10.0.8.2/24 dev eth2   # H: R4-R1, R1 usa .2 (ID basso)
ip link set eth2 up
ip address add 10.0.9.2/24 dev eth3   # J: R5-R1, R1 usa .2 (ID basso)
ip link set eth3 up

# Subnet B (PC2): via R5 (costo 1+1+1=3, meglio di R1-R2 diretto costo 5)
ip route add 10.0.2.0/24 via 10.0.9.3

# Subnet C (PC3): via R5 (costo 1+1=2)
ip route add 10.0.3.0/24 via 10.0.9.3

# Subnet D (DNS): via R4 (diretto H, costo 2 - ottimale!)
ip route add 10.0.4.0/24 via 10.0.8.3

# Subnet F (R2-R3): via R5
ip route add 10.0.6.0/24 via 10.0.9.3

# Subnet G (R3-R4): via R5
ip route add 10.0.7.0/24 via 10.0.9.3

# Subnet K (R5-R2): via R5
ip route add 10.0.10.0/24 via 10.0.9.3

# Subnet L (R5-R3): via R5
ip route add 10.0.11.0/24 via 10.0.9.3

# Subnet M (R5-R4): via R5
ip route add 10.0.12.0/24 via 10.0.9.3
