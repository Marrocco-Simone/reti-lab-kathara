ip address add 10.0.4.2/24 dev eth0   # D: R4 lato DNS
ip link set eth0 up
ip address add 10.0.7.3/24 dev eth1   # G: R3-R4, R4 usa .3 (ID alto)
ip link set eth1 up
ip address add 10.0.8.3/24 dev eth2   # H: R4-R1, R4 usa .3 (ID alto)
ip link set eth2 up
ip address add 10.0.12.2/24 dev eth3  # M: R5-R4, R4 usa .2 (ID basso)
ip link set eth3 up

# Subnet A (PC1): via R1 (diretto H, costo 2)
ip route add 10.0.1.0/24 via 10.0.8.2

# Subnet B (PC2): via R5 (costo 2+1+1=4)
ip route add 10.0.2.0/24 via 10.0.12.3

# Subnet C (PC3): via R5 (costo 2+1=3, meglio di R4-R3 diretto costo 6!)
ip route add 10.0.3.0/24 via 10.0.12.3

# Subnet E (R1-R2): via R1
ip route add 10.0.5.0/24 via 10.0.8.2

# Subnet F (R2-R3): via R5
ip route add 10.0.6.0/24 via 10.0.12.3

# Subnet J (R5-R1): via R1
ip route add 10.0.9.0/24 via 10.0.8.2

# Subnet K (R5-R2): via R5
ip route add 10.0.10.0/24 via 10.0.12.3

# Subnet L (R5-R3): via R5
ip route add 10.0.11.0/24 via 10.0.12.3
