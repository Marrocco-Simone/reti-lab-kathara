ip address add 10.0.2.2/24 dev eth0   # B: R2 lato PC2
ip link set eth0 up
ip address add 10.0.5.3/24 dev eth1   # E: R1-R2, R2 usa .3 (ID alto)
ip link set eth1 up
ip address add 10.0.6.2/24 dev eth2   # F: R2-R3, R2 usa .2 (ID basso)
ip link set eth2 up
ip address add 10.0.10.2/24 dev eth3  # K: R5-R2, R2 usa .2 (ID basso)
ip link set eth3 up

# Subnet A (PC1): via R3 (costo 1+1+1=3, meglio di R2-R1 diretto costo 5)
ip route add 10.0.1.0/24 via 10.0.6.3

# Subnet C (PC3): via R3 (diretto F, costo 1)
ip route add 10.0.3.0/24 via 10.0.6.3

# Subnet D (DNS): via R3 (costo 1+1+2=4)
ip route add 10.0.4.0/24 via 10.0.6.3

# Subnet G (R3-R4): via R3
ip route add 10.0.7.0/24 via 10.0.6.3

# Subnet H (R4-R1): via R3
ip route add 10.0.8.0/24 via 10.0.6.3

# Subnet J (R5-R1): via R3
ip route add 10.0.9.0/24 via 10.0.6.3

# Subnet L (R5-R3): via R3
ip route add 10.0.11.0/24 via 10.0.6.3

# Subnet M (R5-R4): via R3
ip route add 10.0.12.0/24 via 10.0.6.3
